#!/usr/bin/env bash
set -euo pipefail

readonly GREEN='\033[1;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

readonly NIX="/nix/var/nix/profiles/default/bin/nix"

if [[ -f ./.blacktail.local ]]; then
  blacktail_env_host_profile="${BLACKTAIL_HOST_PROFILE:-}"
  blacktail_env_username="${BLACKTAIL_USERNAME:-}"
  blacktail_env_mac_name="${BLACKTAIL_MAC_NAME:-}"
  # shellcheck disable=SC1091
  source ./.blacktail.local
  BLACKTAIL_HOST_PROFILE="${blacktail_env_host_profile:-${BLACKTAIL_HOST_PROFILE:-}}"
  BLACKTAIL_USERNAME="${blacktail_env_username:-${BLACKTAIL_USERNAME:-}}"
  BLACKTAIL_MAC_NAME="${blacktail_env_mac_name:-${BLACKTAIL_MAC_NAME:-}}"
fi

if [[ -z "${BLACKTAIL_HOST_PROFILE:-}" ]]; then
  printf '%s\n' "Set BLACKTAIL_HOST_PROFILE to a configured profile such as personal, runner, or work." >&2
  exit 1
fi

if [[ ! "${BLACKTAIL_HOST_PROFILE}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
  printf '%s\n' "BLACKTAIL_HOST_PROFILE contains invalid characters." >&2
  exit 1
fi

if [[ -z "${BLACKTAIL_USERNAME:-}" ]]; then
  printf '%s\n' "Set BLACKTAIL_USERNAME to your macOS account name." >&2
  exit 1
fi

if [[ ! "${BLACKTAIL_USERNAME}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
  printf '%s\n' "BLACKTAIL_USERNAME contains invalid characters." >&2
  exit 1
fi

if [[ ! -f ./private-config/default.nix ]]; then
  printf '%s\n' "Private configuration is missing. Run git submodule update --init private-config." >&2
  exit 1
fi

readonly HOST_PROFILE="${BLACKTAIL_HOST_PROFILE}"
readonly FLAKE_SYSTEM="darwinConfigurations.${HOST_PROFILE}.system"

printf '%b\n' "${YELLOW}Authenticating for the configuration switch...${NC}"
sudo -v

username_input=$(mktemp -d)
mac_name_input=$(mktemp -d)
sudo_keepalive_pid=
cleanup() {
  if [[ -n "${sudo_keepalive_pid}" ]]; then
    kill "${sudo_keepalive_pid}" 2>/dev/null || true
    wait "${sudo_keepalive_pid}" 2>/dev/null || true
  fi
  rm -rf "${username_input}" "${mac_name_input}"
}
trap cleanup EXIT

# Refresh the sudo timestamp while building, without prompting again.
(
  sleep_pid=
  trap '
    if [[ -n "${sleep_pid}" ]]; then
      kill "${sleep_pid}" 2>/dev/null || true
      wait "${sleep_pid}" 2>/dev/null || true
    fi
  ' EXIT
  trap 'exit' TERM INT
  while true; do
    sleep 60 &
    sleep_pid=$!
    wait "${sleep_pid}"
    sleep_pid=
    sudo -n -v || exit
  done
) &
sudo_keepalive_pid=$!

printf '%s' "${BLACKTAIL_USERNAME}" > "${username_input}/username"
printf '%s' "${BLACKTAIL_MAC_NAME:-}" > "${mac_name_input}/name"

printf '%b\n' "${YELLOW}Starting ${HOST_PROFILE} build...${NC}"
system_path=$("${NIX}" build --no-link --print-out-paths "git+file://${PWD}?submodules=1#${FLAKE_SYSTEM}" --override-input blacktailUsername "path:${username_input}" --override-input blacktailMacName "path:${mac_name_input}" --no-write-lock-file "$@")

printf '%b\n' "${YELLOW}Switching to the ${HOST_PROFILE} configuration...${NC}"
# See https://github.com/nix-darwin/nix-darwin/issues/1457 on why we need sudo
sudo -n "${system_path}/sw/bin/darwin-rebuild" switch --flake "git+file://${PWD}?submodules=1#${HOST_PROFILE}" --override-input blacktailUsername "path:${username_input}" --override-input blacktailMacName "path:${mac_name_input}" --no-write-lock-file "$@"

printf '%b\n' "${GREEN}Switch complete.${NC}"
