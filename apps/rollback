#!/usr/bin/env bash
set -euo pipefail

readonly GREEN='\033[1;32m'
readonly YELLOW='\033[1;33m'
readonly RED='\033[1;31m'
readonly NC='\033[0m'
readonly DARWIN_REBUILD="/run/current-system/sw/bin/darwin-rebuild"

if [[ ! -x "${DARWIN_REBUILD}" ]]; then
  printf '%b\n' "${RED}No active nix-darwin installation found.${NC}"
  exit 1
fi

printf '%b\n' "${YELLOW}Available generations:${NC}"
"${DARWIN_REBUILD}" --list-generations

printf '%b\n' "${YELLOW}Enter the generation number for rollback:${NC}"
read -r generation

if [[ ! "${generation}" =~ ^[0-9]+$ ]]; then
  printf '%b\n' "${RED}Enter a numeric generation number.${NC}"
  exit 1
fi

printf '%b\n' "${YELLOW}Rolling back to generation ${generation}...${NC}"
sudo "${DARWIN_REBUILD}" switch --switch-generation "${generation}"

printf '%b\n' "${GREEN}Rollback to generation ${generation} complete.${NC}"
